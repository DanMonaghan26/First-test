generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  CUSTOM_DAYS
}

model User {
  id           String   @id @default(cuid())
  name         String
  // Nullable: a member can be added as a placeholder (name + color only, no
  // login) until an admin invites them by setting an email. passwordHash is
  // also nullable — a member can sign in with email only, no password.
  email        String?  @unique
  passwordHash String?
  role         Role     @default(MEMBER)
  color        String   @default("#6366f1")
  createdAt    DateTime @default(now())

  events        Event[] @relation("OwnedEvents")
  createdEvents Event[] @relation("CreatedEvents")
  subscriptions CalendarSubscription[]
}

model Event {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  date      DateTime
  startTime String
  endTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A reminder has no meaningful time slot — startTime is stored as "00:00"
  // as a placeholder (unused for display) and the event is shown pinned at
  // the top of the day instead of positioned by time.
  isReminder Boolean @default(false)

  // Recurrence: date above is the series' first occurrence / anchor.
  recurrenceType    RecurrenceType @default(NONE)
  recurrenceDays    Int[]          @default([]) // 0=Sunday..6=Saturday, only used by CUSTOM_DAYS
  recurrenceEndDate DateTime?

  owner   User   @relation("OwnedEvents", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  createdBy   User   @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  // Shared by every row created in a single "add event" or import submission
  // (which can span several distinct events, e.g. a whole import), so the
  // whole set can be undone together. Null for legacy rows.
  batchId String?

  // Shared only by the sibling rows of ONE specific event — the ones created
  // by expanding it across several family members and/or a date range.
  // Narrower than batchId (an import submission creates many eventGroupIds,
  // one per row). Used for "apply this edit to every calendar/date this
  // event was added to." Null for legacy rows.
  eventGroupId String?

  // Present only for events imported from a subscribed external calendar
  // (e.g. a school calendar feed). externalUid identifies the specific
  // occurrence in that feed so re-syncing can update/remove it correctly.
  subscription   CalendarSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String?
  externalUid    String?

  @@unique([subscriptionId, externalUid])
  @@index([ownerId, date])
  @@index([createdById, subscriptionId, createdAt])
  @@index([batchId])
  @@index([eventGroupId])
}

model DisplayToken {
  id        String   @id @default(cuid())
  token     String   @unique
  label     String   @default("Kitchen TV")
  createdAt DateTime @default(now())
}

model CalendarSubscription {
  id             String    @id @default(cuid())
  url            String
  label          String?
  lastSyncedAt   DateTime?
  lastSyncStatus String? // "ok" | "error"
  lastSyncError  String?
  createdAt      DateTime  @default(now())

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  events Event[]
}
