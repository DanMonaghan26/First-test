DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-secret"

# Set to "true" only if this app is served over HTTPS (e.g. behind a reverse
# proxy, or a public deployment). Leave unset/false for a plain-http home LAN
# setup, otherwise login cookies won't be sent and sign-in will silently fail.
COOKIE_SECURE="false"
