# A Postgres connection string. For local development you can run your own
# Postgres, or just point this at a free hosted database (Neon, Supabase, etc.)
# — see README.md for the full walkthrough.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Used only for running migrations (prisma migrate deploy/dev). Must be a
# DIRECT (non-pooled) connection — if you're on Neon, this is the connection
# string WITHOUT "-pooler" in the hostname (Neon dashboard has separate
# "Pooled connection" and "Direct connection" strings). If you're not using
# a connection pooler, this can just be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-secret"

# Set to "true" once this app is served over HTTPS (Vercel and most hosted
# platforms are HTTPS by default — set this to true there). Leave false only
# for a plain-http home LAN setup, otherwise login cookies won't be sent and
# sign-in will silently fail.
COOKIE_SECURE="false"

# Optional. Powers the "Import from text" page, which uses Claude to pull
# calendar events out of pasted text or a URL (e.g. a school newsletter that
# isn't published as a proper calendar feed). Get a key from
# https://console.anthropic.com/settings/keys. Leave unset to skip this
# feature — the rest of the app works fine without it.
ANTHROPIC_API_KEY=""
